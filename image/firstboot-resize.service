[Unit]
Description=SmartEdge first-boot rootfs resize (grow to fill the whole eMMC)
Documentation=man:resize2fs(8)
# Plain after-local-fs oneshot: boot never depends on it (unlike init=),
# a failure only means "retry on next boot".
After=local-fs.target
ConditionPathExists=!/var/lib/smartedge/.rootfs_resized

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/firstboot-resize.sh
TimeoutStartSec=600
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
