// SPDX-License-Identifier: GPL-2.0
/*
 * Avnet SmartEdge Industrial IoT Gateway (AVTSE-RPI-IIOTG) device tree.
 *
 * Ported to kernel 6.18 (arm64) from the old 4.14.79 BSP:
 *   base template : bcm2710-rpi-3-b.dts @ rpi-6.18.y
 *   source        : bcm2710-rpi-custom.dts @ old Avnet fork 4.14.79
 *
 * NOTE: the core board is a Raspberry Pi 3 Model B (BCM2837), NOT a 3B+.
 * Verified 2026-10-12: old Avnet DTS compatible "raspberrypi,3-model-b",
 * smsc9514 ethernet, BCM43430A1 wifi/bt, 10/100 LAN, revision 0x60a220b0.
 * (A previous revision of this file was based on the 3B+ template; the
 * only real difference was the LAN7515 node and LED wiring, both
 * corrected here.)
 *
 * Board specifics driven here:
 *   I2C1 (50kHz, ATtiny clock stretching): @0x33 ATtiny, @0x43/@0x44 FXL6408,
 *                                          @0x51 PCF8563 RTC
 *   SPI2 (aux): CE0=GPIO31 SC16IS740 (RS-232/485), CE1=GPIO44 MCP2515 (CAN),
 *               CE2=GPIO45 SLB9670 TPM
 *   eMMC: SD1 pins GPIO34-39
 *
 * Differences from the 3B template marked with "SmartEdge:" comments below.
 */

/dts-v1/;

#include "bcm2710.dtsi"
#include "bcm2709-rpi.dtsi"
#include "bcm283x-rpi-smsc9514.dtsi"
#include "bcm283x-rpi-csi1-2lane.dtsi"
#include "bcm283x-rpi-i2c0mux_0_44.dtsi"
#include "bcm271x-rpi-bt.dtsi"
#include "bcm283x-rpi-led-deprecated.dtsi"

/ {
	compatible = "avnet,smartedge-iiot-gateway",
		     "raspberrypi,3-model-b", "brcm,bcm2837";
	model = "Avnet SmartEdge Industrial IoT Gateway";

	aliases {
		/*
		 * SmartEdge: the GPU firmware flips serial0/serial1 whenever
		 * uart0 is enabled (verified 2026-10-14), so the aliases are
		 * pre-set to the post-flip state - the firmware rewrite then
		 * becomes a no-op. The PL011 lives on the GPIO header, so
		 * /dev/serial0 = the header UART, exactly the stock semantics.
		 */
		serial0 = &uart0;
		serial1 = &uart1;
		mmc1 = &mmcnr;
		bluetooth = &minibt;
	};

	/* SmartEdge: external oscillators for UART bridge and CAN controller */
	clocks {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		sc16is740_clk: sc16is740_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <14745600>;
		};

		can21_osc: can21_osc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <16000000>;
		};
	};
};

&gpio {
	/*
	 * SmartEdge: GPIO usage differs from the stock reference board:
	 *   GPIO28  FXL6408 @0x43 interrupt (DIO)
	 *   GPIO29  MCP2515  interrupt
	 *   GPIO30  SC16IS740 interrupt
	 *   GPIO31  SPI2 CS0  (also claimed by the BT uart0 pins on a stock 3B)
	 *   GPIO40-42 SPI2 MISO/MOSI/SCLK (audio_pins on a stock 3B+ -> dropped)
	 *   GPIO43  BT GPCLK2
	 *   GPIO44  SPI2 CS1
	 *   GPIO45  SPI2 CS2
	 *
	 * Note: audio_pins (GPIO40/41) and the &vchiq audio pinctrl of the
	 * stock board are deliberately NOT instantiated here - GPIO40/41 are
	 * SPI2 data lines on this board.
	 */
	gpio-line-names = "ID_SDA",
			  "ID_SCL",
			  "GPIO2",
			  "GPIO3",
			  "GPIO4",
			  "GPIO5",
			  "GPIO6",
			  "GPIO7",
			  "GPIO8",
			  "GPIO9",
			  "GPIO10",
			  "GPIO11",
			  "GPIO12",
			  "GPIO13",
			  "GPIO14",
			  "GPIO15",
			  "GPIO16",
			  "GPIO17",
			  "GPIO18",
			  "GPIO19",
			  "GPIO20",
			  "GPIO21",
			  "GPIO22",
			  "GPIO23",
			  "GPIO24",
			  "GPIO25",
			  "GPIO26",
			  "GPIO27",
			  "FXL6408_IRQ_N",
			  "CAN_IRQ_N",
			  "SC16IS740_IRQ_N",
			  "SPI2_CE0_N",
			  "UART0_TXD",
			  "UART0_RXD",
			  "SD1_CLK",
			  "SD1_CMD",
			  "SD1_DATA0",
			  "SD1_DATA1",
			  "SD1_DATA2",
			  "SD1_DATA3",
			  "SPI2_MISO",
			  "SPI2_MOSI",
			  "SPI2_SCLK",
			  "BT_CLK",
			  "SPI2_CE1_N",
			  "SPI2_CE2_N",
			  "SDA0",
			  "SCL0",
			  "SMPS_SCL",
			  "SMPS_SDA",
			  "NC",
			  "NC",
			  "NC",
			  "NC";

	spi0_pins: spi0_pins {
		brcm,pins = <9 10 11>;
		brcm,function = <4>; /* alt0 */
	};

	spi0_cs_pins: spi0_cs_pins {
		brcm,pins = <8 7>;
		brcm,function = <1>; /* output */
	};

	/* SmartEdge: SPI2 on GPIO40-42, alt4 */
	spi2_pins: spi2_pins {
		brcm,pins = <40 41 42>;
		brcm,function = <BCM2835_FSEL_ALT4>;
	};

	/* SmartEdge: SPI2 chip selects are plain outputs (GPIO31/44/45) */
	spi2_cs_pins: spi2_cs_pins {
		brcm,pins = <31 44 45>;
		brcm,function = <BCM2835_FSEL_GPIO_OUT>;
	};

	i2c0_pins: i2c0 {
		brcm,pins = <0 1>;
		brcm,function = <4>;
	};

	i2c1_pins: i2c1 {
		brcm,pins = <2 3>;
		brcm,function = <4>;
	};

	i2s_pins: i2s {
		brcm,pins = <18 19 20 21>;
		brcm,function = <4>; /* alt0 */
	};

	sdio_pins: sdio_pins {
		brcm,pins =     <34 35 36 37 38 39>;
		brcm,function = <7>; // alt3 = SD1
		brcm,pull =     <0 2 2 2 2 2>;
	};

	bt_pins: bt_pins {
		brcm,pins = <43>;
		brcm,function = <4>; /* alt0:GPCLK2 */
		brcm,pull = <0>;
	};

	/*
	 * SmartEdge: PL011 pins on the GPIO header (14/15, /dev/ttyAMA0 =
	 * /dev/serial0). The node is deliberately NOT named "uart0_pins":
	 * whenever uart0 is enabled, the official GPU firmware rewrites the
	 * node of that exact name to the standard Pi3 BT quad (GPIO30-33) -
	 * which would trample GPIO30 (SC16IS740 IRQ) and GPIO31 (SPI2 CE0).
	 * Verified 2026-10-14: the rewrite targets the node NAME only and
	 * leaves every other pinctrl node untouched.
	 */
	uart0_hat_pins: uart0_hat_pins {
		brcm,pins = <14 15>;
		brcm,function = <4>; /* alt0 = PL011 */
		brcm,pull = <0 2>;
	};

	/*
	 * SmartEdge: the mini-uart carries the onboard BT, 2-wire on
	 * GPIO32/33 (alt5) plus the 32.768kHz LPO clock on GPIO43 (GPCLK2,
	 * muxed via bt_pins). This arrangement ran stable on the board from
	 * 2026-10-09; keeping it as the compiled-in default lets
	 * /dev/serial0 stay on the PL011/header permanently.
	 */
	uart1_bt_pins: uart1_bt_pins {
		brcm,pins = <32 33>;
		brcm,function = <BCM2835_FSEL_ALT5>; /* alt5=UART1 */
		brcm,pull = <0 2>;
	};

	/*
	 * Inert placeholder: the firmware rewrites the values of the node
	 * literally named "uart0_pins" when uart0 is enabled. Nothing
	 * references it, so the rewrite is a no-op.
	 */
	uart0_pins: uart0_pins {
		brcm,pins = <32 33>;
		brcm,function = <7>; /* alt3=UART0 */
		brcm,pull = <0 2>;
	};

	/* SmartEdge: interrupt inputs from SPI2 peripherals and DIO expander */
	sc16is740_pins: sc16is740_pins {
		brcm,pins = <30>;
		brcm,function = <BCM2835_FSEL_GPIO_IN>;
	};

	can21_pins: can21_pins {
		brcm,pins = <29>;
		brcm,function = <BCM2835_FSEL_GPIO_IN>;
	};
};

/*
 * SmartEdge: eMMC replaces the microSD card. mmcnr is the non-removable
 * variant of the SD1 controller and still hosts the SDIO WiFi device -
 * same arrangement as a stock 3B (card + SDIO share the SD1 bus).
 */
&mmcnr {
	pinctrl-names = "default";
	pinctrl-0 = <&sdio_pins>;
	bus-width = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	brcm,overclock-50 = <0>;

	brcmf: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&firmware {
	expgpio: expgpio {
		compatible = "raspberrypi,firmware-gpio";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "BT_ON",
				  "WL_ON",
				  "STATUS_LED",
				  "LAN_RUN",
				  "HDMI_HPD_N",
				  "CAM_GPIO0",
				  "CAM_GPIO1",
				  "PWR_LOW_N";
		status = "okay";
	};

	/*
	 * SmartEdge: the firmware virtual GPIO drives the activity LED
	 * (same arrangement as the stock 3B and the original Avnet DTS).
	 */
	virtgpio: virtgpio {
		compatible = "brcm,bcm2835-virtgpio";
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};
};

/*
 * SmartEdge: UART arrangement (compiled-in default, single DTB):
 *   uart0 (PL011)  -> GPIO header, GPIO14/15 alt0: /dev/ttyAMA0,
 *                     /dev/serial0, boot console - stock 3B semantics.
 *   uart1 (mini-u) -> onboard BT, GPIO32/33 alt5 2-wire + GPIO43 LPO
 *                     clock; serdev "minibt" @921600.
 * When uart0 is enabled the GPU firmware (a) rewrites the values of the
 * pinctrl node literally named "uart0_pins" (left unreferenced above,
 * so inert) and (b) flips serial0/serial1 (pre-applied in aliases);
 * it attaches no pinctrl of its own, so GPIO30/31 (SC16IS740 IRQ,
 * SPI2 CE0) are never touched. Verified 2026-10-14.
 */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_hat_pins>;
	status = "okay";
};

/* SmartEdge: mini-uart carries the onboard BT (2-wire + LPO clock) */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_bt_pins &bt_pins>;
	status = "okay";
};

/* SmartEdge: PL011-side BT serdev retired in favour of the mini-uart */
&bt {
	status = "disabled";
};

/* SmartEdge: minibt (mini-uart BT) is the compiled-in default */
&minibt {
	status = "okay";
	/* 921600: proven on this board's 2-wire BT link (2026-10-09..14);
	 * upstream default 230400 would also work but wastes headroom. */
	max-speed = <921600>;
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins &spi0_cs_pins>;
	cs-gpios = <&gpio 8 1>, <&gpio 7 1>;

	spidev0: spidev@0{
		compatible = "spidev";
		reg = <0>;	/* CE0 */
		#address-cells = <1>;
		#size-cells = <0>;
		spi-max-frequency = <125000000>;
	};

	spidev1: spidev@1{
		compatible = "spidev";
		reg = <1>;	/* CE1 */
		#address-cells = <1>;
		#size-cells = <0>;
		spi-max-frequency = <125000000>;
	};
};

/* SmartEdge: auxiliary block supplies the SPI2 clock */
&aux {
	status = "okay";
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins &spi2_cs_pins>;
	cs-gpios = <&gpio 31 1>, <&gpio 44 1>, <&gpio 45 1>;
	status = "okay";

	/* Isolated RS-232/485/422 transceiver */
	sc16is740: sc16is740@0 {
		compatible = "nxp,sc16is740";
		reg = <0>; /* CE0 = GPIO31 */
		pinctrl-names = "default";
		pinctrl-0 = <&sc16is740_pins>;
		spi-max-frequency = <4000000>;
		clocks = <&sc16is740_clk>;
		interrupt-parent = <&gpio>;
		/*
		 * SC16IS7xx asserts an open-drain level-low interrupt, but the
		 * level mode locked the board up in the old BSP (shared with
		 * the TPM). Falling-edge keeps the ISR one-shot.
		 */
		interrupts = <30 2>; /* GPIO30, IRQ_TYPE_EDGE_FALLING */
		/*
		 * RS-485 is asserted by default (DE/RE tied to the bridge);
		 * kept disabled here - userspace toggles it per port via TIOCSRS485.
		 */
		status = "okay";
	};

	/* Isolated CAN controller */
	can21: mcp2515@1 {
		compatible = "microchip,mcp2515";
		reg = <1>; /* CE1 = GPIO44 */
		pinctrl-names = "default";
		pinctrl-0 = <&can21_pins>;
		spi-max-frequency = <10000000>;
		clocks = <&can21_osc>;
		interrupt-parent = <&gpio>;
		interrupts = <29 8>; /* GPIO29, IRQ_TYPE_LEVEL_LOW */
		status = "okay";
	};

	/*
	 * Trusted Platform Module.
	 * NOTE: upstream tpm_tis_spi has no DT reset support, so the old
	 * "gpio-reset" property was dropped - the reset line is released by
	 * the gpio-hog on the FXL6408 @0x44 instead (see below).
	 * NOTE: no IRQ wired - the shared IRQ with SC16IS740 caused an
	 * interrupt storm in the old BSP; the driver works in polling mode.
	 */
	tpm_tis22: tpm_tis@2 {
		compatible = "tcg,tpm_tis-spi";
		reg = <2>; /* CE2 = GPIO45 */
		spi-max-frequency = <10000000>;
		status = "okay";
	};
};

&i2c0if {
	clock-frequency = <100000>;
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	/* SmartEdge: ATtiny cannot take the traffic at 100kHz (bus errors) */
	clock-frequency = <50000>;
	status = "okay";

	/*
	 * Isolated digital I/O. Even-numbered lines are inputs, odd ones
	 * outputs (see User Guide). Line names mirror the legacy sysfs
	 * numbering of the old BSP so existing documentation still applies -
	 * the kernel base number is dynamic in 6.18, so userspace must look
	 * the lines up with libgpiod (by name or chip/offset), not by 200+.
	 */
	dio_in: gpio@43 {
		compatible = "fcs,fxl6408";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		gpio-line-names = "GPIO200", "GPIO201", "GPIO202", "GPIO203",
				  "GPIO204", "GPIO205", "GPIO206", "GPIO207";
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio>;
		interrupts = <28 8>; /* GPIO28, IRQ_TYPE_LEVEL_LOW */
	};

	dio_out: gpio@44 {
		compatible = "fcs,fxl6408";
		reg = <0x44>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		gpio-line-names = "GPIO208", "GPIO209", "GPIO210", "GPIO211",
				  "GPIO212", "GPIO213", "GPIO214", "GPIO215";

		/*
		 * SmartEdge: line 3 of this expander drives the TPM reset
		 * (active low). Hog it high so the TPM is out of reset; this
		 * replaces the reset handling the old BSP had in the driver.
		 */
		tpm_reset_hog: tpm-reset-hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "TPM_RESET_N";
		};
	};

	/* System management MCU: watchdog, LEDs, factory-reset button */
	attiny: attiny@33 {
		compatible = "avid,attiny";
		reg = <0x33>;
		status = "okay";
	};

	/* Battery backed RTC */
	rtc: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};
};

&i2c2 {
	clock-frequency = <100000>;
};

&i2s {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_pins>;
};

/*
 * SmartEdge: the 3B+ activity LED (GPIO29) does not exist on this board -
 * GPIO29 is the MCP2515 interrupt. Like the original Avnet DTS and the
 * stock 3B, the activity LED sits on the firmware's virtual GPIO.
 */
&led_act {
	gpios = <&virtgpio 0 GPIO_ACTIVE_HIGH>;
	default-state = "off";
	linux,default-trigger = "mmc0";
};

&leds {
	led_pwr: led-pwr {
		label = "PWR";
		gpios = <&expgpio 7 GPIO_ACTIVE_HIGH>;
		default-state = "off";
		linux,default-trigger = "input";
	};
};

&hdmi {
	hpd-gpios = <&expgpio 4 GPIO_ACTIVE_LOW>;
};

&vchiq {
	/* no audio pins available - GPIO40/41 are SPI2 */
	status = "okay";
};

&cam1_reg {
	gpio = <&expgpio 5 GPIO_ACTIVE_HIGH>;
};

cam0_reg: &cam_dummy_reg {
};

i2c_csi_dsi0: &i2c0 {
};

/ {
	__overrides__ {
		audio = <&chosen>,"bootargs{on='snd_bcm2835.enable_headphones=1 snd_bcm2835.enable_hdmi=1',off='snd_bcm2835.enable_headphones=0 snd_bcm2835.enable_hdmi=0'}";

		act_led_gpio = <&led_act>,"gpios:4";
		act_led_activelow = <&led_act>,"gpios:8";
		act_led_trigger = <&led_act>,"linux,default-trigger";

		pwr_led_gpio = <&led_pwr>,"gpios:4";
		pwr_led_activelow = <&led_pwr>,"gpios:8";
		pwr_led_trigger = <&led_pwr>,"linux,default-trigger";

		/*
		 * SmartEdge serial options (config.txt) - the original Avnet
		 * four-option block collapses into one DTB + one switch,
		 * because the UART roles are fixed at compile time:
		 *
		 *   default            /dev/serial0 = PL011 on the header
		 *                      (ttyAMA0, console), /dev/serial1 = BT
		 *                      mini-uart; covers the original options
		 *                      0/1/2 semantics (BT reachable as hci0,
		 *                      header UART on serial0 either way)
		 *
		 *   smartedge_bt=off   disable onboard BT (original option 3);
		 *                      the mini-uart then shows up as a plain
		 *                      /dev/ttyS0 on GPIO32/33
		 *
		 * BT baud rate is adjustable with the upstream krnbt_baudrate
		 * override (e.g. dtparam=krnbt_baudrate=115200).
		 */
		smartedge_bt = <&minibt>,"status";
	};
};
