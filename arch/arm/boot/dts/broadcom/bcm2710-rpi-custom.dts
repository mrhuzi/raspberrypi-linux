// SPDX-License-Identifier: GPL-2.0
/*
 * Avnet SmartEdge Industrial IoT Gateway (AVTSE-RPI-IIOTG) device tree.
 *
 * Ported to kernel 6.18 (arm64) from the old 4.14.79 BSP:
 *   base template : bcm2710-rpi-3-b-plus.dts @ rpi-6.18.y
 *   source        : bcm2710-rpi-custom.dts   @ old Avnet fork 4.14.79
 *
 * Board specifics driven here:
 *   I2C1 (50kHz, ATtiny clock stretching): @0x33 ATtiny, @0x43/@0x44 FXL6408,
 *                                          @0x51 PCF8563 RTC
 *   SPI2 (aux): CE0=GPIO31 SC16IS740 (RS-232/485), CE1=GPIO44 MCP2515 (CAN),
 *               CE2=GPIO45 SLB9670 TPM
 *   eMMC: SD1 pins GPIO34-39
 *
 * Differences from the 3B+ template marked with "SmartEdge:" comments below.
 */

/dts-v1/;

#include "bcm2710.dtsi"
#include "bcm2709-rpi.dtsi"
#include "bcm283x-rpi-lan7515.dtsi"
#include "bcm283x-rpi-csi1-2lane.dtsi"
#include "bcm283x-rpi-i2c0mux_0_44.dtsi"
#include "bcm271x-rpi-bt.dtsi"
#include "bcm283x-rpi-led-deprecated.dtsi"

/ {
	compatible = "avnet,smartedge-iiot-gateway",
		     "raspberrypi,3-model-b-plus", "brcm,bcm2837";
	model = "Avnet SmartEdge Industrial IoT Gateway";

	aliases {
		serial0 = &uart1;
		serial1 = &uart0;
		mmc1 = &mmcnr;
	};

	/* SmartEdge: external oscillators for UART bridge and CAN controller */
	clocks {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		sc16is740_clk: sc16is740_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <14745600>;
		};

		can21_osc: can21_osc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <16000000>;
		};
	};
};

&gpio {
	/*
	 * SmartEdge: GPIO usage differs from the 3B+ reference board:
	 *   GPIO28  FXL6408 @0x43 interrupt (DIO)
	 *   GPIO29  MCP2515  interrupt
	 *   GPIO30  SC16IS740 interrupt
	 *   GPIO31  SPI2 CS0  (also claimed by the BT uart1 pins on a stock 3B+)
	 *   GPIO40-42 SPI2 MISO/MOSI/SCLK (audio_pins on a stock 3B+ -> dropped)
	 *   GPIO43  BT GPCLK2
	 *   GPIO44  SPI2 CS1
	 *   GPIO45  SPI2 CS2
	 *
	 * Note: audio_pins (GPIO40/41) and the &vchiq audio pinctrl of the
	 * stock board are deliberately NOT instantiated here - GPIO40/41 are
	 * SPI2 data lines on this board.
	 */
	gpio-line-names = "ID_SDA",
			  "ID_SCL",
			  "GPIO2",
			  "GPIO3",
			  "GPIO4",
			  "GPIO5",
			  "GPIO6",
			  "GPIO7",
			  "GPIO8",
			  "GPIO9",
			  "GPIO10",
			  "GPIO11",
			  "GPIO12",
			  "GPIO13",
			  "GPIO14",
			  "GPIO15",
			  "GPIO16",
			  "GPIO17",
			  "GPIO18",
			  "GPIO19",
			  "GPIO20",
			  "GPIO21",
			  "GPIO22",
			  "GPIO23",
			  "GPIO24",
			  "GPIO25",
			  "GPIO26",
			  "GPIO27",
			  "HDMI_HPD_N",
			  "CAN_IRQ_N",
			  "SC16IS740_IRQ_N",
			  "SPI2_CE0_N",
			  "UART0_TXD",
			  "UART0_RXD",
			  "SD1_CLK",
			  "SD1_CMD",
			  "SD1_DATA0",
			  "SD1_DATA1",
			  "SD1_DATA2",
			  "SD1_DATA3",
			  "SPI2_MISO",
			  "SPI2_MOSI",
			  "SPI2_SCLK",
			  "BT_CLK",
			  "SPI2_CE1_N",
			  "SPI2_CE2_N",
			  "SDA0",
			  "SCL0",
			  "SMPS_SCL",
			  "SMPS_SDA",
			  "FXL6408_IRQ_N",
			  "NC",
			  "NC",
			  "NC";

	spi0_pins: spi0_pins {
		brcm,pins = <9 10 11>;
		brcm,function = <4>; /* alt0 */
	};

	spi0_cs_pins: spi0_cs_pins {
		brcm,pins = <8 7>;
		brcm,function = <1>; /* output */
	};

	/* SmartEdge: SPI2 on GPIO40-42, alt4 */
	spi2_pins: spi2_pins {
		brcm,pins = <40 41 42>;
		brcm,function = <BCM2835_FSEL_ALT4>;
	};

	/* SmartEdge: SPI2 chip selects are plain outputs (GPIO31/44/45) */
	spi2_cs_pins: spi2_cs_pins {
		brcm,pins = <31 44 45>;
		brcm,function = <BCM2835_FSEL_GPIO_OUT>;
	};

	i2c0_pins: i2c0 {
		brcm,pins = <0 1>;
		brcm,function = <4>;
	};

	i2c1_pins: i2c1 {
		brcm,pins = <2 3>;
		brcm,function = <4>;
	};

	i2s_pins: i2s {
		brcm,pins = <18 19 20 21>;
		brcm,function = <4>; /* alt0 */
	};

	sdio_pins: sdio_pins {
		brcm,pins =     <34 35 36 37 38 39>;
		brcm,function = <7>; // alt3 = SD1
		brcm,pull =     <0 2 2 2 2 2>;
	};

	bt_pins: bt_pins {
		brcm,pins = <43>;
		brcm,function = <4>; /* alt0:GPCLK2 */
		brcm,pull = <0>;
	};

	uart0_pins: uart0_pins {
		brcm,pins = <32 33>;
		brcm,function = <7>; /* alt3=UART0 */
		brcm,pull = <0 2>;
	};

	uart1_pins: uart1_pins {
		brcm,pins;
		brcm,function;
		brcm,pull;
	};

	uart1_bt_pins: uart1_bt_pins {
		brcm,pins = <32 33 30 31>;
		brcm,function = <BCM2835_FSEL_ALT5>; /* alt5=UART1 */
		brcm,pull = <0 2 2 0>;
	};

	/* SmartEdge: interrupt inputs from SPI2 peripherals and DIO expander */
	sc16is740_pins: sc16is740_pins {
		brcm,pins = <30>;
		brcm,function = <BCM2835_FSEL_GPIO_IN>;
	};

	can21_pins: can21_pins {
		brcm,pins = <29>;
		brcm,function = <BCM2835_FSEL_GPIO_IN>;
	};
};

/*
 * SmartEdge: eMMC replaces the microSD card. mmcnr is the non-removable
 * variant of the SD1 controller and still hosts the SDIO WiFi device -
 * same arrangement as a stock 3B+ (card + SDIO share the SD1 bus).
 */
&mmcnr {
	pinctrl-names = "default";
	pinctrl-0 = <&sdio_pins>;
	bus-width = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	brcm,overclock-50 = <0>;

	brcmf: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&firmware {
	expgpio: expgpio {
		compatible = "raspberrypi,firmware-gpio";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "BT_ON",
				  "WL_ON",
				  "PWR_LED_R",
				  "LAN_RUN",
				  "NC",
				  "CAM_GPIO0",
				  "CAM_GPIO1",
				  "NC";
		status = "okay";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins &bt_pins>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins &spi0_cs_pins>;
	cs-gpios = <&gpio 8 1>, <&gpio 7 1>;

	spidev0: spidev@0{
		compatible = "spidev";
		reg = <0>;	/* CE0 */
		#address-cells = <1>;
		#size-cells = <0>;
		spi-max-frequency = <125000000>;
	};

	spidev1: spidev@1{
		compatible = "spidev";
		reg = <1>;	/* CE1 */
		#address-cells = <1>;
		#size-cells = <0>;
		spi-max-frequency = <125000000>;
	};
};

/* SmartEdge: auxiliary block supplies the SPI2 clock */
&aux {
	status = "okay";
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins &spi2_cs_pins>;
	cs-gpios = <&gpio 31 1>, <&gpio 44 1>, <&gpio 45 1>;
	status = "okay";

	/* Isolated RS-232/485/422 transceiver */
	sc16is740: sc16is740@0 {
		compatible = "nxp,sc16is740";
		reg = <0>; /* CE0 = GPIO31 */
		pinctrl-names = "default";
		pinctrl-0 = <&sc16is740_pins>;
		spi-max-frequency = <4000000>;
		clocks = <&sc16is740_clk>;
		interrupt-parent = <&gpio>;
		/*
		 * SC16IS7xx asserts an open-drain level-low interrupt, but the
		 * level mode locked the board up in the old BSP (shared with
		 * the TPM). Falling-edge keeps the ISR one-shot.
		 */
		interrupts = <30 2>; /* GPIO30, IRQ_TYPE_EDGE_FALLING */
		/*
		 * RS-485 is asserted by default (DE/RE tied to the bridge);
		 * kept disabled here - userspace toggles it per port via TIOCSRS485.
		 */
		status = "okay";
	};

	/* Isolated CAN controller */
	can21: mcp2515@1 {
		compatible = "microchip,mcp2515";
		reg = <1>; /* CE1 = GPIO44 */
		pinctrl-names = "default";
		pinctrl-0 = <&can21_pins>;
		spi-max-frequency = <10000000>;
		clocks = <&can21_osc>;
		interrupt-parent = <&gpio>;
		interrupts = <29 8>; /* GPIO29, IRQ_TYPE_LEVEL_LOW */
		status = "okay";
	};

	/*
	 * Trusted Platform Module.
	 * NOTE: upstream tpm_tis_spi has no DT reset support, so the old
	 * "gpio-reset" property was dropped - the reset line is released by
	 * the gpio-hog on the FXL6408 @0x44 instead (see below).
	 * NOTE: no IRQ wired - the shared IRQ with SC16IS740 caused an
	 * interrupt storm in the old BSP; the driver works in polling mode.
	 */
	tpm_tis22: tpm_tis@2 {
		compatible = "tcg,tpm_tis-spi";
		reg = <2>; /* CE2 = GPIO45 */
		spi-max-frequency = <10000000>;
		status = "okay";
	};
};

&i2c0if {
	clock-frequency = <100000>;
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	/* SmartEdge: ATtiny cannot take the traffic at 100kHz (bus errors) */
	clock-frequency = <50000>;
	status = "okay";

	/*
	 * Isolated digital I/O. Even-numbered lines are inputs, odd ones
	 * outputs (see User Guide). Line names mirror the legacy sysfs
	 * numbering of the old BSP so existing documentation still applies -
	 * the kernel base number is dynamic in 6.18, so userspace must look
	 * the lines up with libgpiod (by name or chip/offset), not by 200+.
	 */
	dio_in: gpio@43 {
		compatible = "fcs,fxl6408";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		gpio-line-names = "GPIO200", "GPIO201", "GPIO202", "GPIO203",
				  "GPIO204", "GPIO205", "GPIO206", "GPIO207";
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio>;
		interrupts = <28 8>; /* GPIO28, IRQ_TYPE_LEVEL_LOW */
	};

	dio_out: gpio@44 {
		compatible = "fcs,fxl6408";
		reg = <0x44>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		gpio-line-names = "GPIO208", "GPIO209", "GPIO210", "GPIO211",
				  "GPIO212", "GPIO213", "GPIO214", "GPIO215";

		/*
		 * SmartEdge: line 3 of this expander drives the TPM reset
		 * (active low). Hog it high so the TPM is out of reset; this
		 * replaces the reset handling the old BSP had in the driver.
		 */
		tpm_reset_hog: tpm-reset-hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "TPM_RESET_N";
		};
	};

	/* System management MCU: watchdog, LEDs, factory-reset button */
	attiny: attiny@33 {
		compatible = "avid,attiny";
		reg = <0x33>;
		status = "okay";
	};

	/* Battery backed RTC */
	rtc: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};
};

&i2c2 {
	clock-frequency = <100000>;
};

&i2s {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_pins>;
};

/*
 * SmartEdge: the stock activity LED lives on GPIO29 here, which is the
 * MCP2515 interrupt. Front-panel LEDs are driven by the ATtiny instead.
 */
&led_act {
	status = "disabled";
};

&leds {
	led_pwr: led-pwr {
		label = "PWR";
		gpios = <&expgpio 2 GPIO_ACTIVE_LOW>;
		default-state = "off";
		linux,default-trigger = "default-on";
	};
};

&hdmi {
	hpd-gpios = <&expgpio 4 GPIO_ACTIVE_LOW>;
};

&vchiq {
	/* no audio pins available - GPIO40/41 are SPI2 */
	status = "okay";
};

&eth_phy {
	microchip,downshift-after = <2>;
};

&cam1_reg {
	gpio = <&expgpio 5 GPIO_ACTIVE_HIGH>;
};

cam0_reg: &cam_dummy_reg {
};

i2c_csi_dsi0: &i2c0 {
};

/ {
	__overrides__ {
		audio = <&chosen>,"bootargs{on='snd_bcm2835.enable_headphones=1 snd_bcm2835.enable_hdmi=1',off='snd_bcm2835.enable_headphones=0 snd_bcm2835.enable_hdmi=0'}";

		act_led_gpio = <&led_act>,"gpios:4";
		act_led_activelow = <&led_act>,"gpios:8";
		act_led_trigger = <&led_act>,"linux,default-trigger";

		pwr_led_gpio = <&led_pwr>,"gpios:4";
		pwr_led_activelow = <&led_pwr>,"gpios:8";
		pwr_led_trigger = <&led_pwr>,"linux,default-trigger";

		eee = <&eth_phy>,"eee-broken-1000t!",
		      <&eth_phy>,"eee-broken-100tx!";
		eth_led0 = <&eth_phy>,"microchip,led-modes:0";
		eth_led1 = <&eth_phy>,"microchip,led-modes:4";
		eth_downshift_after = <&eth_phy>,"microchip,downshift-after:0";
		eth_max_speed = <&eth_phy>,"max-speed:0";
	};
};
